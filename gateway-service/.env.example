# Gateway Service 环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改

# ========== JWT 配置 ==========
# JWT 密钥，必须使用 Base64 编码
# 生成方式: echo -n "your-secret-key" | base64
JWT_SECRET="bXlTZWNyZXRLZXkxMjM0NTY3ODkwYWJjZGVmZ2hpams="

# ========== CORS 配置 ==========
# 允许的源地址，多个使用逗号分隔
# 开发环境: CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# 生产环境: CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ========== Redis 配置 ==========
# Redis 服务器地址
SPRING_REDIS_HOST="localhost"
# Redis 端口
SPRING_REDIS_PORT="6379"
# Redis 连接超时（毫秒）
SPRING_REDIS_TIMEOUT="2000"

# ========== 日志配置 ==========
# 日志级别: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ORG_FINGER="DEBUG"
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_GATEWAY="INFO"

# ========== 网关配置 ==========
# 应用名称
SPRING_APPLICATION_NAME="gateway-service"
# 网关服务端口
SERVER_PORT="8080"

# ========== 限流参数调整 ==========
# 用户服务限流参数
USER_SERVICE_RATE_LIMIT_REPLENISH_RATE="20"
USER_SERVICE_RATE_LIMIT_BURST_CAPACITY="40"

# 邮箱服务限流参数（可以设置更严格）
EMAIL_SERVICE_RATE_LIMIT_REPLENISH_RATE="5"
EMAIL_SERVICE_RATE_LIMIT_BURST_CAPACITY="10"

# 默认限流参数
DEFAULT_RATE_LIMIT_REPLENISH_RATE="10"
DEFAULT_RATE_LIMIT_BURST_CAPACITY="20"

# ========== 后端服务地址 ==========
# 注：在生产环境建议使用服务发现（如 Nacos）而不是硬编码地址
USER_SERVICE_URL="http://localhost:8081"
LOGIN_SERVICE_URL="http://localhost:8082"
EMAIL_SERVICE_URL="http://localhost:8083"
EXPORT_SERVICE_URL="http://localhost:8084"
OPERATOR_LOG_URL="http://localhost:8085"

# ========== 监控配置 ==========
# 是否启用metrics端点
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE="health,info,metrics,prometheus"
# 健康检查详细程度
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS="when-authorized"
